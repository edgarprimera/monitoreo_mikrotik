# ===================================================
# CONFIGURACIÓN GENERAL Y ALERTAS
# ===================================================
TZ=America/Caracas
EXPORTER_PORT=9177
CHECK_INTERVAL_SECONDS=10

# Alertas Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890
# Intervalo de envío de reportes con gráficas por router en minutos (0 = desactivado / manual por demanda)
TELEGRAM_REPORT_INTERVAL_MINUTES=0
# URL de Prometheus (detectada automáticamente en Docker como http://prometheus:9090)
# PROMETHEUS_URL=http://localhost:9090

# ===================================================
# PARQUE DE ROUTERS MIKROTIK
# Para agregar más routers, incrementa el índice: ROUTER_3, ROUTER_4, etc.
# ===================================================

# Router 1
ROUTER_1_ID=RB-CORE-01
ROUTER_1_HOST=192.168.88.1
ROUTER_1_PORT=8728
ROUTER_1_USER=usr_monitoreo
ROUTER_1_PASS=TuPasswordSeguro1
# Lista blanca: interfaces recolectadas en Prometheus y Grafana
ROUTER_1_MONITOR_IFACES=ether1,sfp-sfpplus1,sfp-sfpplus2
# Interfaz WAN para reportes gráficos de Telegram (si no se define, auto-detecta la que contenga 'WAN')
ROUTER_1_WAN_IFACE=ether1
# Interfaces LAN internas (opcional)
ROUTER_1_LAN_IFACES=sfp-sfpplus1,sfp-sfpplus2
# Opcional: interfaces que además disparan alertas prioritarias / remediación
ROUTER_1_CRITICAL_IFACES=ether1,sfp-sfpplus1

# Router 2
ROUTER_2_ID=RB-DISTRIBUCION-02
ROUTER_2_HOST=192.168.88.2
ROUTER_2_PORT=8728
ROUTER_2_USER=usr_monitoreo
ROUTER_2_PASS=TuPasswordSeguro2
ROUTER_2_MONITOR_IFACES=ether1,sfp-sfpplus1
ROUTER_2_CRITICAL_IFACES=ether1
